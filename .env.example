# Shopify Dev Dashboard credentials (optional: without them the Global Catalog is called keyless and rate limited)
CLIENT_ID=
CLIENT_SECRET=
# Public URL of your agent profile (serve public/profiles/unbox-agent.json from a public host)
AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
# auto = live with mock fallback · 1 = always mock · 0 = always live
MOCK=auto
# Required by merchant Cart/Checkout MCPs (Shopify-Buyer-IP). Set when testing locally behind 127.0.0.1.
BUYER_IP=
PORT=3000
